Options -MultiViews -Indexes
RewriteEngine On

# Serve existing files directly (JS, CSS, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Homepage: trinitetech.com or trinitetech.com/
RewriteRule ^$ /index.html [L]

# Handle /services/ai-solution, /services/ai-solution/ etc. (nested pages)
RewriteCond %{DOCUMENT_ROOT}/services/%1.html -f
RewriteRule ^services/([^/]+)/?$ /services/$1.html [L]

# Handle /services/ -> services.html (avoid 403 on directory)
RewriteRule ^services/?$ /services.html [L]

# Handle all other top-level clean URLs: /about-us, /contact, /career, /jobs
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ /$1.html [L]

# Fallback 404
RewriteRule ^ /404.html [L]
